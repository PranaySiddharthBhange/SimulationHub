# Copy to .env; configure the key locally, never commit it.
OPENAI_API_KEY=
PROJECTS_ROOT=./projects

# One reasoning model per stage. Existing STAGE_1_EXTRACTION_MODEL and
# STAGE_2/3_MAPPING_MODEL settings also work; STAGE_N_MODEL takes precedence.
STAGE_1_MODEL=gpt-5.4-mini
STAGE_2_MODEL=gpt-5.4-mini
STAGE_3_MODEL=gpt-5.4-mini

TOTAL_BUDGET_USD=6
STAGE_1_BUDGET_USD=2
STAGE_2_BUDGET_USD=2
STAGE_3_BUDGET_USD=2
# Estimates only: set these to your actual model/account rates. One in-flight
# call may cross the estimate; the next call is blocked. Repairs share the cap.
PRICE_PER_1K_INPUT_USD=0.00025
PRICE_PER_1K_OUTPUT_USD=0.001
MAX_REPAIR_ATTEMPTS=3
MAX_CONTEXT_CHARS=300000
MAX_OUTPUT_TOKENS=16000

USE_REAL_SYSML_PARSER=true
USE_REAL_COMPILER=true
SYSML_PARSER_TIMEOUT_SECONDS=90
OMC_TIMEOUT_SECONDS=120
# SYSML_AGENT_KERNEL_DIR=C:/path/to/share/jupyter/kernels
# MODELICA_AGENT_OMC_PATH=C:/path/to/bin/omc.exe
