OPENAI_API_KEY=
SYSML_AGENT_PROJECTS_ROOT=./projects

# Models for the three LLM-dependent stages (defaults are real model ids —
# see DECISIONS.md for why this needed checking rather than assuming).
SYSML_AGENT_PLANNING_MODEL=gpt-5.4-mini
SYSML_AGENT_MAPPING_MODEL=gpt-5.4-mini
SYSML_AGENT_VALIDATION_MODEL=gpt-5.4-mini

# Hard cap on estimated LLM spend per generation run. The run stops before
# the next LLM call once this is reached — see observability/budget_guard.py.
SYSML_AGENT_BUDGET_USD=2.0

# Placeholder per-token prices used to estimate spend against the cap above
# (NOT real billing data — override if you know your account's actual rates).
SYSML_AGENT_PRICE_PER_1K_INPUT_USD=0.00025
SYSML_AGENT_PRICE_PER_1K_OUTPUT_USD=0.001

# Real SysML v2 syntax validation (validation/real_syntax_validator.py),
# used automatically when the local conda "sysml" kernel is installed;
# set to false to force the regex-only fallback checker instead.
SYSML_AGENT_USE_REAL_PARSER=true
SYSML_AGENT_REAL_PARSER_TIMEOUT_SECONDS=90.0

# Override only if the SysML v2 Jupyter kernel isn't in one of the default
# conda env locations find_kernel_dir() checks.
# SYSML_AGENT_KERNEL_DIR=
