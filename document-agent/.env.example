OPENAI_API_KEY=
ENGINEERING_AGENT_PROJECTS_ROOT=./projects

# Hard cap on estimated LLM spend per ingestion run. The run stops before
# the next LLM call once this is reached — see observability/budget_guard.py.
ENGINEERING_AGENT_BUDGET_USD=2.0

# Placeholder per-token prices used to estimate spend against the cap above
# (NOT real billing data — override if you know your account's actual rates).
ENGINEERING_AGENT_PRICE_PER_1K_INPUT_USD=0.00025
ENGINEERING_AGENT_PRICE_PER_1K_OUTPUT_USD=0.001
