# Default Stage 1 backend. Project metadata may override this per project.
# ollama = local Gemma text extraction; image-only files are skipped.
# openai = cloud GPT-5.4 extraction; visual evidence can be processed.
STAGE_1_BACKEND=ollama
PROJECTS_ROOT=./projects

TOTAL_BUDGET_USD=10
STAGE_1_BUDGET_USD=2.0
STAGE_2_BUDGET_USD=2.0
STAGE_3_BUDGET_USD=2.0
PRICE_PER_1K_INPUT_USD=0.00025
PRICE_PER_1K_OUTPUT_USD=0.001

OPENAI_MODEL=gpt-5.4
MERGE_MODEL=gpt-5.4

STAGE_1_EXTRACTION_MODEL=gemma3:4b

STAGE_2_MAPPING_MODEL=gpt-5.4
STAGE_3_MAPPING_MODEL=gpt-5.4

# Four repairs after the initial generation = five total attempts.
MAX_REPAIR_ATTEMPTS=4
STAGE_2_REPAIR_BUDGET_USD=2.0
STAGE_3_REPAIR_BUDGET_USD=2.0

USE_REAL_SYSML_PARSER=true
SYSML_PARSER_TIMEOUT_SECONDS=90.0
# SYSML_AGENT_KERNEL_DIR=

USE_REAL_COMPILER=true
OMC_TIMEOUT_SECONDS=120.0
# MODELICA_AGENT_OMC_PATH=
OPENAI_API_KEY=
