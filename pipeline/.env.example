STAGE_1_BACKEND=openai
PROJECTS_ROOT=./projects

TOTAL_BUDGET_USD=10
STAGE_1_BUDGET_USD=2.0
STAGE_2_BUDGET_USD=2.0
STAGE_3_BUDGET_USD=2.0
PRICE_PER_1K_INPUT_USD=0.0025
PRICE_PER_1K_OUTPUT_USD=0.01

OPENAI_MODEL=gpt-5.4
MERGE_MODEL=gpt-5.4

STAGE_1_EXTRACTION_MODEL=gemma3:4b

STAGE_2_MAPPING_MODEL=gpt-5.4
STAGE_3_MAPPING_MODEL=gpt-5.4

MAX_REPAIR_ATTEMPTS=4
STAGE_2_REPAIR_BUDGET_USD=2.0
STAGE_3_REPAIR_BUDGET_USD=2.0

# Two extra Stage 3 <-> Stage 4 validation-repair rounds after the first = three total.
MAX_VALIDATION_REPAIR_ATTEMPTS=2

USE_REAL_SYSML_PARSER=true
SYSML_PARSER_TIMEOUT_SECONDS=90.0
# SYSML_AGENT_KERNEL_DIR=

USE_REAL_COMPILER=true
OMC_TIMEOUT_SECONDS=120.0
# MODELICA_AGENT_OMC_PATH=
OPENAI_API_KEY=