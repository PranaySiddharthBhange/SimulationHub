model TwoTankSystem
  import Modelica.Units.SI;
  TankUnit tank1(crossArea=1.20, level_start=0.05) annotation(Placement(transformation(extent={{-10,30},{30,70}})));
  TankUnit tank2(crossArea=1.40, level_start=0.05) annotation(Placement(transformation(extent={{90,30},{130,70}})));
  OnOffValve valve1(nominalFlow=0.0060) annotation(Placement(transformation(extent={{-90,40},{-50,80}})));
  OnOffValve valve2(nominalFlow=0.0045) annotation(Placement(transformation(extent={{40,40},{80,80}})));
  OnOffValve valve3(nominalFlow=0.0050) annotation(Placement(transformation(extent={{140,40},{180,80}})));
  TankController PLC_101 annotation(Placement(transformation(extent={{30,-90},{110,-10}})));
  Modelica.Blocks.Sources.BooleanTable startCmd(table={20,20.5,280,280.5}) annotation(Placement(transformation(extent={{-180,-40},{-160,-20}})));
  Modelica.Blocks.Sources.BooleanTable stopCmd(table={220,220.5,650,650.5}) annotation(Placement(transformation(extent={{-180,-70},{-160,-50}})));
  Modelica.Blocks.Sources.BooleanTable shutCmd(table={700,700.5}) annotation(Placement(transformation(extent={{-180,-100},{-160,-80}})));
  Real tank1_level_m;
  Real tank2_level_m;
  Real valve1_open;
  Real valve2_open;
  Real valve3_open;
  Integer controller_state;
equation
  connect(startCmd.y, PLC_101.startButton) annotation(Line(points={{-159,-30},{-80,-30},{-80,-22},{30,-22}}, color={255,0,255}));
  connect(stopCmd.y, PLC_101.stopButton) annotation(Line(points={{-159,-60},{-70,-60},{-70,-38},{30,-38}}, color={255,0,255}));
  connect(shutCmd.y, PLC_101.shutButton) annotation(Line(points={{-159,-90},{-60,-90},{-60,-54},{30,-54}}, color={255,0,255}));
  connect(PLC_101.valve1Cmd, valve1.openCmd) annotation(Line(points={{110,60},{120,60},{120,100},{-120,100},{-120,60},{-90,60}}, color={255,0,255}));
  connect(PLC_101.valve2Cmd, valve2.openCmd) annotation(Line(points={{110,20},{120,20},{120,0},{20,0},{20,60},{40,60}}, color={255,0,255}));
  connect(PLC_101.valve3Cmd, valve3.openCmd) annotation(Line(points={{110,-20},{120,-20},{120,-40},{190,-40},{190,60},{140,60}}, color={255,0,255}));
  connect(valve1.flowOut, tank1.inflow) annotation(Line(points={{-49,60},{-20,60},{-20,42},{-10,42}}, color={0,0,127}));
  connect(valve2.flowOut, tank2.inflow) annotation(Line(points={{81,60},{84,60},{84,42},{90,42}}, color={0,0,127}));
  connect(valve2.flowOut, tank1.outflowCmd) annotation(Line(points={{81,60},{84,60},{84,10},{-30,10},{-30,-42},{-10,-42}}, color={0,0,127}));
  connect(valve3.flowOut, tank2.outflowCmd) annotation(Line(points={{181,60},{186,60},{186,10},{80,10},{80,-42},{90,-42}}, color={0,0,127}));
  connect(tank1.levelOut, PLC_101.tank1Level) annotation(Line(points={{31,50},{40,50},{40,0},{20,0},{20,-46},{30,-46}}, color={0,0,127}));
  connect(tank2.levelOut, PLC_101.tank2Level) annotation(Line(points={{131,50},{150,50},{150,-130},{-30,-130},{-30,-78},{30,-78}}, color={0,0,127}));
  tank1_level_m = tank1.levelOut;
  tank2_level_m = tank2.levelOut;
  valve1_open = if PLC_101.valve1Cmd then 100 else 0;
  valve2_open = if PLC_101.valve2Cmd then 100 else 0;
  valve3_open = if PLC_101.valve3Cmd then 100 else 0;
  controller_state = PLC_101.controller_state;
  annotation(experiment(StartTime=0, StopTime=900, Interval=0.1, Tolerance=1e-6), Diagram(graphics={Text(extent={{-192,96},{-120,84}}, textString="Commands"), Text(extent={{-96,94},{182,84}}, textString="SRC-101 -> XV-101 -> TK-101 -> XV-102 -> TK-102 -> XV-103 -> DRN-101")}));
end TwoTankSystem;
