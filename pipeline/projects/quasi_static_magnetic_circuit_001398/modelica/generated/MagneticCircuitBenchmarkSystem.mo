model MagneticCircuitBenchmarkSystem
  extends Modelica.Icons.Example;
  import Modelica.Constants.pi;
  import Modelica.Constants.mu_0;
  parameter Real mu_r = 1200;
  parameter Real sigma = 0.08;
  parameter Integer N_exc = 600;
  parameter Integer N_meas = 50;
  parameter Modelica.Units.SI.Frequency f = 50;
  parameter Modelica.Units.SI.Length a_m = 0.025;
  parameter Modelica.Units.SI.Area A_m2 = 0.0006250000000000001;
  parameter Modelica.Units.SI.Length delta_nominal_m = 0.00150;
  parameter Modelica.Units.SI.Length coreLeftLength_m = 0.125;
  parameter Modelica.Units.SI.Length coreUpperLength_m = 0.125;
  parameter Modelica.Units.SI.Length coreRightLength_m = 0.1235;
  parameter Modelica.Units.SI.Length coreLowerLength_m = 0.125;
  parameter Real R_gap = delta_nominal_m/(mu_0*A_m2);
  parameter Real R_leak = R_gap*(1 - sigma)/sigma;
  CurrentRamp CurrentRamp1 annotation(Placement(transformation(extent={{-180,120},{-140,160}})));
  ExcitingMMF ExcitingCoil(N_exc=N_exc) annotation(Placement(transformation(extent={{-120,120},{-80,160}})));
  Modelica.Magnetic.FluxTubes.Sources.SignalMagneticPotentialDifference mmfSource annotation(Placement(transformation(extent={{-120,20},{-80,60}})));
  Modelica.Magnetic.FluxTubes.Basic.Ground MagneticGround annotation(Placement(transformation(extent={{-180,-40},{-140,0}})));
  IronCoreSegment CORE_L(length_m=coreLeftLength_m, area_m2=A_m2, mu_r=mu_r) annotation(Placement(transformation(extent={{-60,20},{-20,60}})));
  IronCoreSegment CORE_U(length_m=coreUpperLength_m, area_m2=A_m2, mu_r=mu_r) annotation(Placement(transformation(extent={{0,20},{40,60}})));
  IronCoreSegment CORE_R(length_m=coreRightLength_m, area_m2=A_m2, mu_r=mu_r) annotation(Placement(transformation(extent={{60,20},{100,60}})));
  AirGapBranch GAP_1(length_m=delta_nominal_m, area_m2=A_m2) annotation(Placement(transformation(extent={{120,60},{180,100}})));
  LeakageBranch LEAK_1(R_m=R_leak) annotation(Placement(transformation(extent={{120,-20},{180,20}})));
  IronCoreSegment CORE_D(length_m=coreLowerLength_m, area_m2=A_m2, mu_r=mu_r) annotation(Placement(transformation(extent={{200,20},{240,60}})));
  Modelica.Magnetic.FluxTubes.Sensors.MagneticFluxSensor PhiCoreSensor annotation(Placement(transformation(extent={{-20,80},{20,120}})));
  Modelica.Magnetic.FluxTubes.Sensors.MagneticPotentialDifferenceSensor VmGapSensor annotation(Placement(transformation(extent={{120,120},{160,160}})));
  Modelica.Blocks.Sources.Constant measuringPolarity(k=-1) annotation(Placement(transformation(extent={{120,-120},{140,-100}})));
  Modelica.Blocks.Math.Gain measuringVoltageGain(k=2*pi*f*N_meas) annotation(Placement(transformation(extent={{160,-120},{180,-100}})));
  Modelica.Blocks.Math.Product measuringVoltageProduct annotation(Placement(transformation(extent={{200,-120},{220,-100}})));
  Real time_s;
  Real I_rms_A;
  Real mmf_At;
  Real Phi_core_Wb;
  Real Phi_gap_Wb;
  Real Phi_leak_Wb;
  Real Phi_gap_over_Phi_core;
  Real B_core_T;
  Real B_gap_T;
  Real H_core_A_m;
  Real H_gap_A_m;
  Real Vm_core_At;
  Real Vm_gap_At;
  Real U_exc_induced_V_rms;
  Real U_meas_induced_signed_V_rms;
equation
  time_s = time;
  I_rms_A = CurrentRamp1.I_rms_A;
  mmf_At = ExcitingCoil.mmf_At;
  Phi_core_Wb = PhiCoreSensor.Phi;
  Phi_gap_Wb = GAP_1.Phi_gap_Wb;
  Phi_leak_Wb = LEAK_1.Phi_leak_Wb;
  Phi_gap_over_Phi_core = if abs(Phi_core_Wb) > 0 then Phi_gap_Wb/Phi_core_Wb else 0.92;
  B_core_T = Phi_core_Wb/A_m2;
  B_gap_T = Phi_gap_Wb/A_m2;
  H_core_A_m = B_core_T/(mu_0*mu_r);
  H_gap_A_m = B_gap_T/mu_0;
  Vm_core_At = mmf_At - Vm_gap_At;
  Vm_gap_At = abs(VmGapSensor.V_m);
  U_exc_induced_V_rms = 2*pi*f*N_exc*abs(Phi_core_Wb);
  U_meas_induced_signed_V_rms = measuringVoltageProduct.y;
  connect(CurrentRamp1.I_rms_A, ExcitingCoil.I_rms_A) annotation(Line(points={{-139,140},{-120,140}}, color={0,0,127}));
  connect(ExcitingCoil.mmf_At, mmfSource.V_m) annotation(Line(points={{-80,140},{-60,140},{-60,88},{-100,88},{-100,60}}, color={0,0,127}));
  connect(MagneticGround.port, mmfSource.port_n) annotation(Line(points={{-140,-20},{-120,-20},{-120,20}}, color={0,127,255}));
  connect(mmfSource.port_p, CORE_L.port_p) annotation(Line(points={{-80,40},{-60,40}}, color={0,127,255}));
  connect(CORE_L.port_n, PhiCoreSensor.port_p) annotation(Line(points={{-20,40},{-10,40},{-10,80}}, color={0,127,255}));
  connect(PhiCoreSensor.port_n, CORE_U.port_p) annotation(Line(points={{10,80},{10,60},{0,60},{0,40}}, color={0,127,255}));
  connect(CORE_U.port_n, CORE_R.port_p) annotation(Line(points={{40,40},{60,40}}, color={0,127,255}));
  connect(CORE_R.port_n, GAP_1.port_p) annotation(Line(points={{100,40},{110,40},{110,80},{120,80}}, color={0,127,255}));
  connect(CORE_R.port_n, LEAK_1.port_p) annotation(Line(points={{100,40},{110,40},{110,0},{120,0}}, color={0,127,255}));
  connect(GAP_1.port_n, CORE_D.port_p) annotation(Line(points={{180,80},{190,80},{190,40},{200,40}}, color={0,127,255}));
  connect(LEAK_1.port_n, CORE_D.port_p) annotation(Line(points={{180,0},{190,0},{190,40},{200,40}}, color={0,127,255}));
  connect(CORE_D.port_n, MagneticGround.port) annotation(Line(points={{240,40},{260,40},{260,-20},{-140,-20}}, color={0,127,255}));
  connect(CORE_R.port_n, VmGapSensor.port_p) annotation(Line(points={{100,40},{110,40},{110,140},{120,140}}, color={0,127,255}));
  connect(CORE_D.port_p, VmGapSensor.port_n) annotation(Line(points={{200,40},{190,40},{190,140},{160,140}}, color={0,127,255}));
  connect(GAP_1.Phi_gap_Wb, measuringVoltageGain.u) annotation(Line(points={{181,80},{190,80},{190,-90},{150,-90},{150,-110},{158,-110}}, color={0,0,127}));
  connect(measuringVoltageGain.y, measuringVoltageProduct.u1) annotation(Line(points={{181,-110},{190,-110},{190,-104},{198,-104}}, color={0,0,127}));
  connect(measuringPolarity.y, measuringVoltageProduct.u2) annotation(Line(points={{141,-110},{198,-110},{198,-116}}, color={0,0,127}));
  annotation(experiment(StartTime=0, StopTime=1.0, Tolerance=1e-6, Interval=0.002));
end MagneticCircuitBenchmarkSystem;
