model MagneticCircuitCore
  import Modelica.Constants.pi;
  import Modelica.Constants.mu_0;
  extends Modelica.Blocks.Icons.Block;
  parameter Real mu_r = 1200;
  parameter Real sigma = 0.08;
  parameter Integer N_exc = 600;
  parameter Integer N_meas = 50;
  parameter Modelica.Units.SI.Frequency f = 50;
  parameter Modelica.Units.SI.Length a = 0.025;
  parameter Modelica.Units.SI.Area A = 0.0006250000000000001;
  parameter Modelica.Units.SI.Length l_left = 0.125;
  parameter Modelica.Units.SI.Length l_upper = 0.125;
  parameter Modelica.Units.SI.Length l_right = 0.1235;
  parameter Modelica.Units.SI.Length l_lower = 0.125;
  parameter Modelica.Units.SI.Length delta = 0.00150;
  Modelica.Blocks.Interfaces.RealInput mmf_At annotation(Placement(transformation(extent={{-120,-20},{-100,20}})));
  Modelica.Blocks.Interfaces.RealOutput Phi_core_Wb annotation(Placement(transformation(extent={{100,80},{120,100}})));
  Modelica.Blocks.Interfaces.RealOutput Phi_gap_Wb annotation(Placement(transformation(extent={{100,50},{120,70}})));
  Modelica.Blocks.Interfaces.RealOutput Phi_leak_Wb annotation(Placement(transformation(extent={{100,20},{120,40}})));
  Modelica.Blocks.Interfaces.RealOutput Phi_gap_over_Phi_core annotation(Placement(transformation(extent={{100,-10},{120,10}})));
  Modelica.Blocks.Interfaces.RealOutput B_core_T annotation(Placement(transformation(extent={{100,-40},{120,-20}})));
  Modelica.Blocks.Interfaces.RealOutput B_gap_T annotation(Placement(transformation(extent={{100,-70},{120,-50}})));
  Modelica.Blocks.Interfaces.RealOutput H_core_A_m annotation(Placement(transformation(extent={{100,-100},{120,-80}})));
  Modelica.Blocks.Interfaces.RealOutput H_gap_A_m annotation(Placement(transformation(extent={{100,-130},{120,-110}})));
  Modelica.Blocks.Interfaces.RealOutput Vm_core_At annotation(Placement(transformation(extent={{100,-160},{120,-140}})));
  Modelica.Blocks.Interfaces.RealOutput Vm_gap_At annotation(Placement(transformation(extent={{100,-190},{120,-170}})));
  Modelica.Blocks.Interfaces.RealOutput U_exc_induced_V_rms annotation(Placement(transformation(extent={{100,-220},{120,-200}})));
  Modelica.Blocks.Interfaces.RealOutput U_meas_induced_signed_V_rms annotation(Placement(transformation(extent={{100,-250},{120,-230}})));
 protected 
  parameter Real R_core = (l_left + l_upper + l_right + l_lower)/(mu_0*mu_r*A);
  parameter Real R_gap = delta/(mu_0*A);
  parameter Real R_leak = R_gap*(1 - sigma)/sigma;
  parameter Real R_parallel = 1/(1/R_gap + 1/R_leak);
 equation
  Phi_core_Wb = mmf_At/(R_core + R_parallel);
  Phi_gap_Wb = (1 - sigma)*Phi_core_Wb;
  Phi_leak_Wb = sigma*Phi_core_Wb;
  Phi_gap_over_Phi_core = if abs(Phi_core_Wb) > 0 then Phi_gap_Wb/Phi_core_Wb else 0.92;
  B_core_T = Phi_core_Wb/A;
  B_gap_T = Phi_gap_Wb/A;
  H_core_A_m = B_core_T/(mu_0*mu_r);
  H_gap_A_m = B_gap_T/mu_0;
  Vm_core_At = H_core_A_m*(l_left + l_upper + l_right + l_lower);
  Vm_gap_At = H_gap_A_m*delta;
  U_exc_induced_V_rms = 2*pi*f*N_exc*Phi_core_Wb;
  U_meas_induced_signed_V_rms = -2*pi*f*N_meas*Phi_gap_Wb;
  annotation(Icon(graphics={Rectangle(extent={{-100,-100},{100,100}}, lineColor={0,0,255}),Line(points={{-70,0},{-20,0}}, color={0,127,255}),Line(points={{-20,0},{20,30}}, color={0,127,255}),Line(points={{-20,0},{20,-30}}, color={0,127,255}),Line(points={{20,30},{70,30}}, color={0,127,255}),Line(points={{20,-30},{70,-30}}, color={0,127,255}),Text(extent={{-100,60},{100,90}}, textString="Core+Gap+Leak"),Text(extent={{-100,100},{100,140}}, textString="%name")}));
end MagneticCircuitCore;
