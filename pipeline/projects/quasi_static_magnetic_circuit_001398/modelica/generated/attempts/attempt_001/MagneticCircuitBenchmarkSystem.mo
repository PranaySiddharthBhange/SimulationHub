model MagneticCircuitBenchmarkSystem
  extends Modelica.Icons.Example;
  CurrentRamp currentRamp annotation(Placement(transformation(extent={{-100,40},{-60,80}})));
  ExcitingMMF excitingCoil(N_exc=600) annotation(Placement(transformation(extent={{-30,40},{10,80}})));
  MagneticCircuitCore magneticCircuit(mu_r=1200, sigma=0.08, N_exc=600, N_meas=50, f=50, a=0.025, A=0.0006250000000000001, l_left=0.125, l_upper=0.125, l_right=0.1235, l_lower=0.125, delta=0.00150) annotation(Placement(transformation(extent={{40,-20},{100,80}})));
  Real time_s;
  Real I_rms_A;
  Real mmf_At;
  Real Phi_core_Wb;
  Real Phi_gap_Wb;
  Real Phi_leak_Wb;
  Real Phi_gap_over_Phi_core;
  Real B_core_T;
  Real B_gap_T;
  Real H_core_A_m;
  Real H_gap_A_m;
  Real Vm_core_At;
  Real Vm_gap_At;
  Real U_exc_induced_V_rms;
  Real U_meas_induced_signed_V_rms;
 equation
  time_s = time;
  I_rms_A = currentRamp.I_rms_A;
  mmf_At = excitingCoil.mmf_At;
  Phi_core_Wb = magneticCircuit.Phi_core_Wb;
  Phi_gap_Wb = magneticCircuit.Phi_gap_Wb;
  Phi_leak_Wb = magneticCircuit.Phi_leak_Wb;
  Phi_gap_over_Phi_core = magneticCircuit.Phi_gap_over_Phi_core;
  B_core_T = magneticCircuit.B_core_T;
  B_gap_T = magneticCircuit.B_gap_T;
  H_core_A_m = magneticCircuit.H_core_A_m;
  H_gap_A_m = magneticCircuit.H_gap_A_m;
  Vm_core_At = magneticCircuit.Vm_core_At;
  Vm_gap_At = magneticCircuit.Vm_gap_At;
  U_exc_induced_V_rms = magneticCircuit.U_exc_induced_V_rms;
  U_meas_induced_signed_V_rms = magneticCircuit.U_meas_induced_signed_V_rms;
  connect(currentRamp.I_rms_A, excitingCoil.I_rms_A) annotation(Line(points={{-59,60},{-30,60}}, color={0,0,127}));
  connect(excitingCoil.mmf_At, magneticCircuit.mmf_At) annotation(Line(points={{10,60},{40,60}}, color={0,0,127}));
  annotation(experiment(StartTime=0, StopTime=1.0, Tolerance=1e-6, Interval=0.002), Diagram(graphics={Text(extent={{-108,88},{-52,96}}, textString="CurrentRamp"),Text(extent={{-36,88},{14,96}}, textString="ExcitingCoil/MMF"),Text(extent={{38,88},{102,96}}, textString="Series core with parallel gap/leak" )}));
end MagneticCircuitBenchmarkSystem;
