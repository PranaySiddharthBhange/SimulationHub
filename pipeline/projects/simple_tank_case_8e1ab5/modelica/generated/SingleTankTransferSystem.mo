model SingleTankTransferSystem
  GenericTankLevel tank1(level_start=0) annotation(Placement(transformation(extent={{-20,40},{20,80}})));
  GenericTankLevel tank2(level_start=0) annotation(Placement(transformation(extent={{80,40},{120,80}})));
  OnOffValveCommand inletValve(nominalFlow=0) annotation(Placement(transformation(extent={{-20,-20},{20,20}})));
  OnOffValveCommand transferValve(nominalFlow=0) annotation(Placement(transformation(extent={{40,-20},{80,20}})));
  OnOffValveCommand drainValve(nominalFlow=0) annotation(Placement(transformation(extent={{100,-20},{140,20}})));
  SingleTankTransferController controller(waitDuration=10, scanPeriod=0.1) annotation(Placement(transformation(extent={{-90,-10},{-40,60}})));
  Modelica.Blocks.Sources.BooleanTable START(table={10,10.1,300,300.1}) annotation(Placement(transformation(extent={{-180,60},{-160,80}})));
  Modelica.Blocks.Sources.BooleanTable STOP(table={120,120.1}) annotation(Placement(transformation(extent={{-180,20},{-160,40}})));
  Modelica.Blocks.Sources.BooleanTable SHUT(table={600,600.1}) annotation(Placement(transformation(extent={{-180,-20},{-160,0}})));
  Modelica.Blocks.Sources.BooleanExpression highLevelTank1(y=false) annotation(Placement(transformation(extent={{-180,-60},{-160,-40}})));
  Modelica.Blocks.Sources.BooleanExpression lowLevelTank1(y=true) annotation(Placement(transformation(extent={{-180,-100},{-160,-80}})));
  Modelica.Blocks.Sources.BooleanExpression lowLevelTank2(y=true) annotation(Placement(transformation(extent={{-180,-140},{-160,-120}})));
  Real tank1_level;
  Real tank2_level;
  Boolean inlet_valve_command;
  Boolean transfer_valve_command;
  Boolean drain_valve_command;
  Integer active_state;
  Real inlet_flow_report;
  Real transfer_flow_report;
  Real drain_flow_report;
equation
  connect(START.y, controller.startButton) annotation(Line(points={{-159,70},{-120,70},{-120,50},{-90,50}}, color={255,0,255}));
  connect(STOP.y, controller.stopButton) annotation(Line(points={{-159,30},{-124,30},{-124,36.6667},{-90,36.6667}}, color={255,0,255}));
  connect(SHUT.y, controller.shutButton) annotation(Line(points={{-159,-10},{-128,-10},{-128,23.3333},{-90,23.3333}}, color={255,0,255}));
  connect(highLevelTank1.y, controller.highLevelTank1) annotation(Line(points={{-159,-50},{-130,-50},{-130,10},{-90,10}}, color={255,0,255}));
  connect(lowLevelTank1.y, controller.lowLevelTank1) annotation(Line(points={{-159,-90},{-134,-90},{-134,-3.3333},{-90,-3.3333}}, color={255,0,255}));
  connect(lowLevelTank2.y, controller.lowLevelTank2) annotation(Line(points={{-159,-130},{-138,-130},{-138,-16.6667},{-90,-16.6667}}, color={255,0,255}));
  connect(controller.inletOpen, inletValve.openCmd) annotation(Line(points={{-40,40},{-30,40},{-30,0},{-20,0}}, color={255,0,255}));
  connect(controller.transferOpen, transferValve.openCmd) annotation(Line(points={{-40,30},{30,30},{30,0},{40,0}}, color={255,0,255}));
  connect(controller.drainOpen, drainValve.openCmd) annotation(Line(points={{-40,20},{90,20},{90,0},{100,0}}, color={255,0,255}));
  connect(inletValve.flowSignal, tank1.inflow) annotation(Line(points={{21,0},{30,0},{30,46},{-20,46}}, color={0,0,127}));
  connect(transferValve.flowSignal, tank1.outflow) annotation(Line(points={{81,0},{90,0},{90,10},{-30,10},{-30,-40},{-20,-40}}, color={0,0,127}));
  connect(transferValve.flowSignal, tank2.inflow) annotation(Line(points={{81,0},{90,0},{90,50},{80,50}}, color={0,0,127}));
  connect(drainValve.flowSignal, tank2.outflow) annotation(Line(points={{141,0},{150,0},{150,30},{70,30},{70,-40},{80,-40}}, color={0,0,127}));
  tank1_level = tank1.level;
  tank2_level = tank2.level;
  inlet_valve_command = controller.inletOpen;
  transfer_valve_command = controller.transferOpen;
  drain_valve_command = controller.drainOpen;
  active_state = controller.activeState;
  inlet_flow_report = inletValve.flowSignal;
  transfer_flow_report = transferValve.flowSignal;
  drain_flow_report = drainValve.flowSignal;
  annotation(experiment(StartTime=0, StopTime=900, Tolerance=1e-6, Interval=0.1));
end SingleTankTransferSystem;
