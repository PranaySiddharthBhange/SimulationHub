  "facts": [
    {
      "category": "requirement",
      "statement": "The controller shall start the automatic fill-transfer-drain sequence upon a valid START command when the process is idle or paused.",
      "ref": "URS-FUN-001",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "The controller shall start the automatic fill-transfer-drain sequence upon a valid START command when the process is idle or paused."
    },
    {
      "category": "requirement",
      "statement": "The automatic sequence shall open inlet valve V1 to fill Tank 1.",
      "ref": "URS-FUN-002",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "The automatic sequence shall open inlet valve V1 to fill Tank 1."
    },
    {
      "category": "behavior",
      "statement": "When Tank 1 reaches its high-level limit, V1 shall close.",
      "ref": "URS-FUN-003",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "When Tank 1 reaches its high-level limit, V1 shall close."
    },
    {
      "category": "requirement",
      "statement": "After Tank 1 reaches the high-level limit, the controller shall wait 10 s before opening V2.",
      "ref": "URS-FUN-004",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "After Tank 1 reaches the high-level limit, the controller shall wait 10 s before opening V2."
    },
    {
      "category": "requirement",
      "statement": "V2 shall transfer liquid from Tank 1 to Tank 2 until Tank 1 reaches its low-level limit.",
      "ref": "URS-FUN-005",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "V2 shall transfer liquid from Tank 1 to Tank 2 until Tank 1 reaches its low-level limit."
    },
    {
      "category": "requirement",
      "statement": "After Tank 1 reaches the low-level limit, the controller shall wait 10 s before opening V3.",
      "ref": "URS-FUN-006",
      "anchor": "[sheet Requirements_Register]",
      "status": "superseded",
      "from_image": false,
      "quote": "After Tank 1 reaches the low-level limit, the controller shall wait 10 s before opening V3."
    },
    {
      "category": "requirement",
      "statement": "V3 shall drain Tank 2 until Tank 2 reaches its low-level limit.",
      "ref": "URS-FUN-007",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "V3 shall drain Tank 2 until Tank 2 reaches its low-level limit."
    },
    {
      "category": "requirement",
      "statement": "After Tank 2 reaches its low-level limit, the controller shall return to the Tank 1 filling operation after 10 s.",
      "ref": "URS-FUN-008",
      "anchor": "[sheet Requirements_Register]",
      "status": "superseded",
      "from_image": false,
      "quote": "After Tank 2 reaches its low-level limit, the controller shall return to the Tank 1 filling operation after 10 s."
    },
    {
      "category": "behavior",
      "statement": "STOP shall close V1, V2 and V3 and place the controller in a paused condition.",
      "ref": "URS-MOD-001",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "STOP shall close V1, V2 and V3 and place the controller in a paused condition."
    },
    {
      "category": "requirement",
      "statement": "A START command following STOP shall continue the sequence from the point at which STOP was accepted.",
      "ref": "URS-MOD-002",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "A START command following STOP shall continue the sequence from the point at which STOP was accepted."
    },
    {
      "category": "behavior",
      "statement": "SHUT shall command V2 and V3 open to drain both tanks and shall inhibit V1.",
      "ref": "URS-MOD-003",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "SHUT shall command V2 and V3 open to drain both tanks and shall inhibit V1."
    },
    {
      "category": "requirement",
      "statement": "After shutdown draining is complete, all three valves shall be closed and the controller shall be in the initial idle configuration.",
      "ref": "URS-MOD-004",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "After shutdown draining is complete, all three valves shall be closed and the controller shall be in the initial idle configuration."
    },
    {
      "category": "behavior",
      "statement": "On loss of controller power, all process valves shall move to or remain in the closed position.",
      "ref": "URS-SAF-001",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "On loss of controller power, all process valves shall move to or remain in the closed position."
    },
    {
      "category": "requirement",
      "statement": "SHUT shall have higher command priority than STOP; STOP shall have higher priority than START.",
      "ref": "URS-SAF-002",
      "anchor": "[sheet Requirements_Register]",
      "status": "active",
      "from_image": false,
      "quote": "SHUT shall have higher command priority than STOP; STOP shall have higher priority than START."
    },
