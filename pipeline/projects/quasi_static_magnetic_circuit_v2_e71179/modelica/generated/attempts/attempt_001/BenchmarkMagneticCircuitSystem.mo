model BenchmarkMagneticCircuitSystem
  extends Modelica.Icons.Example;
  parameter Modelica.Units.SI.Length a_m = 0.025;
  parameter Modelica.Units.SI.Length l_m = 0.150;
  parameter Modelica.Units.SI.Length delta_m = 0.00150;
  parameter Real mu_r = 1200;
  parameter Real sigma(min=0, max=1) = 0.08;
  parameter Integer N_exc = 600;
  parameter Integer N_meas = 50;
  parameter Modelica.Units.SI.Frequency f_Hz = 50;
  parameter Modelica.Units.SI.Permeability mu0_H_per_m = Modelica.Constants.mu_0;
  parameter Modelica.Units.SI.Area A_m2 = a_m*a_m;
  parameter Modelica.Units.SI.Length l_core_m = 3*(l_m - a_m) + (l_m - a_m - delta_m);
  parameter Modelica.Units.SI.Reluctance R_core_A_per_Wb = l_core_m/(mu0_H_per_m*mu_r*A_m2);
  parameter Modelica.Units.SI.Reluctance R_gap_A_per_Wb = delta_m/(mu0_H_per_m*A_m2);
  parameter Modelica.Units.SI.Reluctance R_leak_A_per_Wb = R_gap_A_per_Wb*(1 - sigma)/sigma;
  parameter Modelica.Units.SI.Reluctance R_par_A_per_Wb = 1/(1/R_gap_A_per_Wb + 1/R_leak_A_per_Wb);
  parameter Modelica.Units.SI.Reluctance R_total_A_per_Wb = R_core_A_per_Wb + R_par_A_per_Wb;

  CurrentRamp currentRamp(offset=0, height=2.0, startTime=0.10, duration=0.40) annotation(Placement(transformation(extent={{-180,70},{-140,110}})));
  Modelica.Blocks.Math.Gain currentToVoltage(k=1) annotation(Placement(transformation(extent={{-120,70},{-100,90}})));
  Modelica.Electrical.Analog.Sources.SignalCurrent excitingCurrent annotation(Placement(transformation(extent={{-80,50},{-60,70}})));
  Modelica.Electrical.Analog.Basic.Resistor excitingResistance(R=1e-6) annotation(Placement(transformation(extent={{-20,50},{0,70}})));
  Modelica.Electrical.Analog.Basic.Ground electricGround annotation(Placement(transformation(extent={{-80,0},{-60,20}})));
  Modelica.Magnetic.FluxTubes.Basic.ElectroMagneticConverter excitingCoil(N=N_exc) annotation(Placement(transformation(extent={{20,40},{60,80}})));
  Modelica.Magnetic.FluxTubes.Basic.Ground magneticGround annotation(Placement(transformation(extent={{160,-80},{180,-60}})));
  Modelica.Magnetic.FluxTubes.Shapes.FixedShape.Cuboid coreL(l=l_m - a_m, a=a_m, b=a_m, mu_rConst=mu_r) annotation(Placement(transformation(extent={{20,-10},{50,20}})));
  Modelica.Magnetic.FluxTubes.Shapes.FixedShape.Cuboid coreU(l=l_m - a_m, a=a_m, b=a_m, mu_rConst=mu_r) annotation(Placement(transformation(extent={{60,-10},{90,20}})));
  Modelica.Magnetic.FluxTubes.Shapes.FixedShape.Cuboid coreR(l=l_m - a_m - delta_m, a=a_m, b=a_m, mu_rConst=mu_r) annotation(Placement(transformation(extent={{100,-10},{130,20}})));
  Modelica.Magnetic.FluxTubes.Basic.ConstantReluctance gap1(R_m=R_gap_A_per_Wb) annotation(Placement(transformation(extent={{100,-70},{130,-40}})));
  LeakageFluxBranch leak1(sigma=sigma) annotation(Placement(transformation(extent={{100,-120},{130,-90}})));
  Modelica.Magnetic.FluxTubes.Shapes.FixedShape.Cuboid coreD(l=l_m - a_m, a=a_m, b=a_m, mu_rConst=mu_r) annotation(Placement(transformation(extent={{140,-10},{170,20}})));
  Modelica.Magnetic.FluxTubes.Sensors.MagneticFluxSensor fluxSensor annotation(Placement(transformation(extent={{60,-70},{90,-40}})));
  Modelica.Magnetic.FluxTubes.Basic.ElectroMagneticConverter measuringCoil(N=N_meas) annotation(Placement(transformation(extent={{20,-120},{60,-80}})));
  Modelica.Electrical.Analog.Basic.Resistor measuringResistance(R=1e9) annotation(Placement(transformation(extent={{-20,-120},{0,-100}})));
  Modelica.Electrical.Analog.Sensors.VoltageSensor excitingVoltageSensor annotation(Placement(transformation(extent={{20,100},{40,120}})));
  Modelica.Electrical.Analog.Sensors.VoltageSensor measuringVoltageSensor annotation(Placement(transformation(extent={{20,-170},{40,-150}})));

  Modelica.Units.SI.Time time_s;
  Modelica.Units.SI.Current I_rms_A;
  Real mmf_At(unit="A.Turn");
  Modelica.Units.SI.MagneticFlux Phi_core_Wb;
  Modelica.Units.SI.MagneticFlux Phi_gap_Wb;
  Modelica.Units.SI.MagneticFlux Phi_leak_Wb;
  Real Phi_gap_over_Phi_core;
  Modelica.Units.SI.MagneticFluxDensity B_core_T;
  Modelica.Units.SI.MagneticFluxDensity B_gap_T;
  Modelica.Units.SI.MagneticFieldStrength H_core_A_m;
  Modelica.Units.SI.MagneticFieldStrength H_gap_A_m;
  Real Vm_core_At(unit="A.Turn");
  Real Vm_gap_At(unit="A.Turn");
  Modelica.Units.SI.Voltage U_exc_induced_V_rms;
  Modelica.Units.SI.Voltage U_meas_induced_signed_V_rms;
equation
  connect(currentRamp.y, currentToVoltage.u) annotation(Line(points={{-139,90},{-122,90},{-122,80}}, color={0,0,127}));
  connect(currentToVoltage.y, excitingCurrent.i) annotation(Line(points={{-99,80},{-90,80},{-90,60},{-80,60}}, color={0,0,127}));
  connect(excitingCurrent.n, electricGround.p) annotation(Line(points={{-70,50},{-70,20}}, color={0,127,255}));
  connect(excitingCurrent.p, excitingResistance.p) annotation(Line(points={{-60,60},{-20,60}}, color={0,127,255}));
  connect(excitingResistance.n, excitingCoil.p) annotation(Line(points={{0,60},{20,60}}, color={0,127,255}));
  connect(excitingCoil.n, electricGround.p) annotation(Line(points={{20,44},{-40,44},{-40,20},{-70,20}}, color={0,127,255}));
  connect(excitingCoil.port_n, magneticGround.port) annotation(Line(points={{56,40},{56,-70},{170,-70}}, color={0,127,255}));
  connect(excitingCoil.port_p, coreL.port_p) annotation(Line(points={{56,80},{56,90},{10,90},{10,5},{20,5}}, color={0,127,255}));
  connect(coreL.port_n, coreU.port_p) annotation(Line(points={{50,5},{60,5}}, color={0,127,255}));
  connect(coreU.port_n, coreR.port_p) annotation(Line(points={{90,5},{100,5}}, color={0,127,255}));
  connect(coreR.port_n, gap1.port_p) annotation(Line(points={{130,5},{136,5},{136,-20},{96,-20},{96,-55},{100,-55}}, color={0,127,255}));
  connect(coreR.port_n, leak1.port_p) annotation(Line(points={{130,5},{136,5},{136,-24},{94,-24},{94,-105},{100,-105}}, color={0,127,255}));
  connect(gap1.port_n, coreD.port_p) annotation(Line(points={{130,-55},{136,-55},{136,5},{140,5}}, color={0,127,255}));
  connect(leak1.port_n, coreD.port_p) annotation(Line(points={{130,-105},{138,-105},{138,5},{140,5}}, color={0,127,255}));
  connect(coreD.port_n, magneticGround.port) annotation(Line(points={{170,5},{176,5},{176,-70},{170,-70}}, color={0,127,255}));
  connect(fluxSensor.port_p, gap1.port_p) annotation(Line(points={{60,-55},{100,-55}}, color={0,127,255}));
  connect(fluxSensor.port_n, gap1.port_n) annotation(Line(points={{90,-55},{130,-55}}, color={0,127,255}));
  connect(measuringCoil.port_p, gap1.port_p) annotation(Line(points={{56,-80},{56,-55},{100,-55}}, color={0,127,255}));
  connect(measuringCoil.port_n, gap1.port_n) annotation(Line(points={{56,-120},{56,-130},{80,-130},{80,-55},{130,-55}}, color={0,127,255}));
  connect(measuringCoil.p, measuringResistance.p) annotation(Line(points={{20,-100},{-20,-110}}, color={0,127,255}));
  connect(measuringResistance.n, measuringCoil.n) annotation(Line(points={{0,-110},{10,-110},{10,-116},{20,-116}}, color={0,127,255}));
  connect(excitingVoltageSensor.p, excitingCoil.p) annotation(Line(points={{20,110},{10,110},{10,60},{20,60}}, color={0,127,255}));
  connect(excitingVoltageSensor.n, excitingCoil.n) annotation(Line(points={{40,110},{70,110},{70,44},{20,44}}, color={0,127,255}));
  connect(measuringVoltageSensor.p, measuringCoil.p) annotation(Line(points={{20,-160},{10,-160},{10,-100},{20,-100}}, color={0,127,255}));
  connect(measuringVoltageSensor.n, measuringCoil.n) annotation(Line(points={{40,-160},{70,-160},{70,-116},{20,-116}}, color={0,127,255}));

  time_s = time;
  I_rms_A = currentRamp.y;
  mmf_At = N_exc*I_rms_A;
  Phi_gap_Wb = fluxSensor.Phi;
  Phi_core_Wb = Phi_gap_Wb/(1 - sigma);
  Phi_leak_Wb = sigma*Phi_core_Wb;
  Phi_gap_over_Phi_core = if abs(Phi_core_Wb) > Modelica.Constants.eps then Phi_gap_Wb/Phi_core_Wb else 1 - sigma;
  B_core_T = Phi_core_Wb/A_m2;
  B_gap_T = Phi_gap_Wb/A_m2;
  H_core_A_m = B_core_T/(mu0_H_per_m*mu_r);
  H_gap_A_m = B_gap_T/mu0_H_per_m;
  Vm_core_At = R_core_A_per_Wb*Phi_core_Wb;
  Vm_gap_At = R_gap_A_per_Wb*Phi_gap_Wb;
  U_exc_induced_V_rms = abs(excitingVoltageSensor.v);
  U_meas_induced_signed_V_rms = -abs(measuringVoltageSensor.v);
  annotation(
    Diagram(coordinateSystem(extent={{-200,-200},{200,140}})),
    experiment(StartTime=0, StopTime=1.0, Tolerance=1e-6, Interval=0.001));
end BenchmarkMagneticCircuitSystem;
