model EvaporatorCondenserUnit
  Modelica.Blocks.Interfaces.RealInput feed_kg_s annotation(Placement(transformation(extent={{-120,60},{-100,80}})));
  Modelica.Blocks.Interfaces.RealInput feed_w annotation(Placement(transformation(extent={{-120,20},{-100,40}})));
  Modelica.Blocks.Interfaces.BooleanInput heaterOn annotation(Placement(transformation(extent={{-120,-20},{-100,0}})));
  Modelica.Blocks.Interfaces.RealInput condenserFlowProof_kg_s annotation(Placement(transformation(extent={{-120,-60},{-100,-40}})));
  Modelica.Blocks.Interfaces.RealOutput level_m annotation(Placement(transformation(extent={{100,80},{120,100}})));
  Modelica.Blocks.Interfaces.RealOutput w_NaCl annotation(Placement(transformation(extent={{100,40},{120,60}})));
  Modelica.Blocks.Interfaces.RealOutput temp_C annotation(Placement(transformation(extent={{100,0},{120,20}})));
  Modelica.Blocks.Interfaces.RealOutput condensateToB6_kg_s annotation(Placement(transformation(extent={{100,-40},{120,-20}})));
  Modelica.Blocks.Interfaces.RealOutput concentrateToB7_kg_s annotation(Placement(transformation(extent={{100,-80},{120,-60}})));
  parameter Modelica.Units.SI.Area area_m2;
  parameter Modelica.Units.SI.Height levelStart_m;
  parameter Real wStart;
  parameter Modelica.Units.SI.Power heaterDuty_W=20000;
  parameter Modelica.Units.SI.MassFlowRate evapNominal_kg_s=0.01;
  parameter Modelica.Units.SI.Density rho_kg_m3=1000;
  parameter Modelica.Units.SI.SpecificHeatCapacity cp_J_kgK=4180;
  parameter Modelica.Units.SI.Mass mMin_kg=0.01;
  parameter Modelica.Units.SI.Temperature Tstart_K=293.15;
  parameter Modelica.Units.SI.MassFlowRate transferToB7Cmd_kg_s=0.30;
  Modelica.Units.SI.Mass m(start=area_m2*levelStart_m*rho_kg_m3, fixed=true);
  Modelica.Units.SI.Mass mSalt(start=area_m2*levelStart_m*rho_kg_m3*wStart, fixed=true);
  Modelica.Units.SI.Temperature T_K(start=Tstart_K, fixed=true);
  Real w;
  Boolean heaterPermissive;
  Modelica.Units.SI.MassFlowRate evap_kg_s;
  Modelica.Units.SI.MassFlowRate toB7_kg_s;
  Modelica.Units.SI.Power appliedHeat_W;
 equation
  w = mSalt/max(m,mMin_kg);
  heaterPermissive = (level_m >= 0.05) and (condenserFlowProof_kg_s >= 0.10);
  appliedHeat_W = if heaterOn and heaterPermissive then heaterDuty_W else 0;
  evap_kg_s = if appliedHeat_W > 0 then min(evapNominal_kg_s, max(0, m - mMin_kg)) else 0;
  toB7_kg_s = if level_m > 0.0 and w_NaCl >= 0.18 and not heaterOn then min(transferToB7Cmd_kg_s, max(0, m - mMin_kg)) else 0;
  der(m) = feed_kg_s - evap_kg_s - toB7_kg_s;
  der(mSalt) = feed_kg_s*feed_w - toB7_kg_s*w;
  der(T_K) = appliedHeat_W/(max(m,mMin_kg)*cp_J_kgK);
  level_m = m/(rho_kg_m3*area_m2);
  w_NaCl = w;
  temp_C = T_K - 273.15;
  condensateToB6_kg_s = evap_kg_s;
  concentrateToB7_kg_s = toB7_kg_s;
  annotation(Icon(graphics={Rectangle(extent={{-80,-80},{0,80}}, lineColor={0,0,255}, fillColor={255,230,170}, fillPattern=FillPattern.Solid),Ellipse(extent={{20,10},{80,70}}, lineColor={0,0,255}, fillColor={215,215,215}, fillPattern=FillPattern.Solid),Text(extent={{-100,100},{100,140}}, textString="%name"),Text(extent={{-72,-12},{-8,20}}, textString="B5"),Text(extent={{26,26},{74,54}}, textString="K1")}));
end EvaporatorCondenserUnit;
