model SimpleBatchVessel
  parameter Modelica.Units.SI.Area area = 0.05;
  parameter Modelica.Units.SI.Height height = 0.5;
  parameter Modelica.Units.SI.Height level_start = 0.01;
  parameter Real w_start = 0.0;
  parameter Modelica.Units.SI.Temperature T_start = 293.15;
  parameter Modelica.Units.SI.Height maxLevel = height;
  parameter Modelica.Units.SI.HeatFlowRate coolingDuty = 0;
  parameter Modelica.Units.SI.HeatFlowRate heatingDuty = 0;
  parameter Real evapRate_nominal = 0;
  Modelica.Blocks.Interfaces.RealInput qIn annotation(Placement(transformation(extent={{-120,60},{-100,80}})));
  Modelica.Blocks.Interfaces.RealInput wIn annotation(Placement(transformation(extent={{-120,20},{-100,40}})));
  Modelica.Blocks.Interfaces.RealInput Tin annotation(Placement(transformation(extent={{-120,-20},{-100,0}})));
  Modelica.Blocks.Interfaces.RealInput qOutCmd annotation(Placement(transformation(extent={{-120,-60},{-100,-40}})));
  Modelica.Blocks.Interfaces.BooleanInput heaterOn annotation(Placement(transformation(extent={{-20,100},{20,120}})));
  Modelica.Blocks.Interfaces.BooleanInput coolerOn annotation(Placement(transformation(extent={{40,100},{80,120}})));
  Modelica.Blocks.Interfaces.RealOutput qOut annotation(Placement(transformation(extent={{100,60},{120,80}})));
  Modelica.Blocks.Interfaces.RealOutput wOut annotation(Placement(transformation(extent={{100,20},{120,40}})));
  Modelica.Blocks.Interfaces.RealOutput TOut annotation(Placement(transformation(extent={{100,-20},{120,0}})));
  Modelica.Blocks.Interfaces.RealOutput level annotation(Placement(transformation(extent={{100,-60},{120,-40}})));
  Modelica.Blocks.Interfaces.RealOutput w annotation(Placement(transformation(extent={{100,-100},{120,-80}})));
  Modelica.Blocks.Interfaces.RealOutput TC annotation(Placement(transformation(extent={{100,-120},{120,-100}})));
protected 
  parameter Real rho = 1000;
  parameter Modelica.Units.SI.SpecificHeatCapacity cp = 4180;
  Modelica.Units.SI.Mass m(start=area*level_start*rho, fixed=true);
  Modelica.Units.SI.Mass mSalt(start=area*level_start*rho*w_start, fixed=true);
  Modelica.Units.SI.Temperature T(start=T_start, fixed=true);
  Modelica.Units.SI.VolumeFlowRate qOutInternal;
  Modelica.Units.SI.MassFlowRate mIn;
  Modelica.Units.SI.MassFlowRate mOut;
  Modelica.Units.SI.MassFlowRate qEvap;
  Modelica.Units.SI.HeatFlowRate Qnet;
equation 
  level = m/(rho*area);
  qOutInternal = if level <= 0 then 0 else qOutCmd;
  mIn = rho*qIn;
  mOut = rho*qOutInternal;
  qEvap = if heaterOn then evapRate_nominal else 0;
  der(m) = mIn - mOut - qEvap;
  der(mSalt) = mIn*wIn - mOut*(if m > 1e-9 then mSalt/m else 0);
  Qnet = mIn*cp*(Tin - T) + (if heaterOn then heatingDuty else 0) + (if coolerOn then coolingDuty else 0);
  der(T) = Qnet/max(1.0, m*cp);
  w = if m > 1e-9 then mSalt/m else 0;
  qOut = qOutInternal;
  wOut = w;
  TOut = T;
  TC = T - 273.15;
  annotation(Icon(graphics={Rectangle(extent={{-80,-100},{80,60}}, lineColor={0,0,255}),Rectangle(extent={{-78,-98},{78,-20}}, fillColor={170,213,255}, fillPattern=FillPattern.Solid, lineColor={0,0,255}),Text(extent={{-100,80},{100,110}}, textString="%name"),Text(extent={{-60,-10},{60,20}}, textString="Tank")}));
end SimpleBatchVessel;
