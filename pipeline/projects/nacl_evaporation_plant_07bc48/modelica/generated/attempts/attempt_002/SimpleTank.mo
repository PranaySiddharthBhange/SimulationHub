model SimpleTank
  parameter Modelica.Units.SI.Area crossArea;
  parameter Modelica.Units.SI.Height maxLevel;
  parameter Modelica.Units.SI.Height initialLevel;
  parameter Real initialWNaCl(unit="kg/kg") = 0;
  parameter Modelica.Units.SI.Temperature initialTemperature = 293.15;
  parameter Modelica.Units.SI.MassFlowRate nominalOutflow = 0;
  parameter Boolean useInlet1 = false;
  parameter Boolean useInlet2 = false;
  Modelica.Blocks.Interfaces.BooleanInput inlet1On if useInlet1 annotation(Placement(transformation(extent={{-120,60},{-100,80}})));
  Modelica.Blocks.Interfaces.RealInput inlet1MassFlow if useInlet1 annotation(Placement(transformation(extent={{-120,30},{-100,50}})));
  Modelica.Blocks.Interfaces.RealInput inlet1WNaCl if useInlet1 annotation(Placement(transformation(extent={{-120,0},{-100,20}})));
  Modelica.Blocks.Interfaces.RealInput inlet1TempC if useInlet1 annotation(Placement(transformation(extent={{-120,-30},{-100,-10}})));
  Modelica.Blocks.Interfaces.BooleanInput inlet2On if useInlet2 annotation(Placement(transformation(extent={{-120,-60},{-100,-40}})));
  Modelica.Blocks.Interfaces.RealInput inlet2MassFlow if useInlet2 annotation(Placement(transformation(extent={{-120,-90},{-100,-70}})));
  Modelica.Blocks.Interfaces.RealInput inlet2WNaCl if useInlet2 annotation(Placement(transformation(extent={{-120,-120},{-100,-100}})));
  Modelica.Blocks.Interfaces.RealInput inlet2TempC if useInlet2 annotation(Placement(transformation(extent={{-120,-150},{-100,-130}})));
  Modelica.Blocks.Interfaces.BooleanInput outletOn annotation(Placement(transformation(extent={{-120,-10},{-100,10}})));
  Modelica.Blocks.Interfaces.RealOutput level_m annotation(Placement(transformation(extent={{100,60},{120,80}})));
  Modelica.Blocks.Interfaces.RealOutput w_NaCl annotation(Placement(transformation(extent={{100,20},{120,40}})));
  Modelica.Blocks.Interfaces.RealOutput temperature_C annotation(Placement(transformation(extent={{100,-20},{120,0}})));
  Modelica.Blocks.Interfaces.RealOutput massOutFlow annotation(Placement(transformation(extent={{100,-60},{120,-40}})));
  Modelica.Blocks.Interfaces.RealOutput outWNaCl annotation(Placement(transformation(extent={{100,-100},{120,-80}})));
  Modelica.Blocks.Interfaces.RealOutput outTempC annotation(Placement(transformation(extent={{100,-140},{120,-120}})));
protected
  constant Modelica.Units.SI.Density rho = 1000;
  Modelica.Units.SI.Mass m(start=crossArea*initialLevel*rho, fixed=true);
  Modelica.Units.SI.Mass mSalt(start=crossArea*initialLevel*rho*initialWNaCl, fixed=true);
  Modelica.Units.SI.Temperature T(start=initialTemperature, fixed=true);
  Modelica.Units.SI.MassFlowRate mIn1;
  Modelica.Units.SI.MassFlowRate mIn2;
  Modelica.Units.SI.MassFlowRate mOut;
  Modelica.Units.SI.HeatFlowRate Qin;
  Modelica.Units.SI.SpecificHeatCapacity cpMix;
equation
  cpMix = WaterNaClMedium.cp(T, if m > 1e-9 then mSalt/m else initialWNaCl);
  mIn1 = if useInlet1 then (if inlet1On and level_m < maxLevel then inlet1MassFlow else 0) else 0;
  mIn2 = if useInlet2 then (if inlet2On and level_m < maxLevel then inlet2MassFlow else 0) else 0;
  mOut = if level_m <= 0 then 0 else if outletOn then min(nominalOutflow, m) else 0;
  der(m) = mIn1 + mIn2 - mOut;
  der(mSalt) = mIn1*(if useInlet1 then inlet1WNaCl else 0) + mIn2*(if useInlet2 then inlet2WNaCl else 0) - mOut*(if m > 1e-9 then mSalt/m else initialWNaCl);
  Qin = mIn1*4180*((if useInlet1 then inlet1TempC + 273.15 else initialTemperature) - T) + mIn2*4180*((if useInlet2 then inlet2TempC + 273.15 else initialTemperature) - T);
  der(T) = if m > 1e-6 then Qin/(m*cpMix) else 0;
  level_m = m/(rho*crossArea);
  w_NaCl = if m > 1e-9 then mSalt/m else initialWNaCl;
  temperature_C = T - 273.15;
  massOutFlow = mOut;
  outWNaCl = w_NaCl;
  outTempC = temperature_C;
  annotation(Icon(graphics={Rectangle(extent={{-80,-80},{80,80}}, lineColor={0,0,255}),Rectangle(extent={{-80,-80},{80,0}}, lineColor={0,0,255}, fillColor={85,170,255}, fillPattern=FillPattern.Solid),Text(extent={{-100,100},{100,140}}, textString="%name")}));
end SimpleTank;
