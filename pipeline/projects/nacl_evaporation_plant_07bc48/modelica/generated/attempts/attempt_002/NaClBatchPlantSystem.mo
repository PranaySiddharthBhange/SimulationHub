model NaClBatchPlantSystem
  extends Modelica.Icons.Example;
  BatchTank B1(area_m2=0.07, levelStart_m=0.5, wStart=0.0, Tstart_K=293.15) annotation(Placement(transformation(extent={{-180,100},{-140,140}})));
  BatchTank B2(area_m2=0.07, levelStart_m=0.35, wStart=0.25, Tstart_K=293.15) annotation(Placement(transformation(extent={{-180,20},{-140,60}})));
  BatchTank B3(area_m2=0.05, levelStart_m=0.01, wStart=0.0, Tstart_K=293.15) annotation(Placement(transformation(extent={{-90,60},{-50,100}})));
  BatchTank B4(area_m2=0.055, levelStart_m=0.01, wStart=0.0, Tstart_K=293.15) annotation(Placement(transformation(extent={{0,60},{40,100}})));
  EvaporatorCondenser B5K1(area_m2=0.06, levelStart_m=0.01, wStart=0.0, Tstart_K=293.15) annotation(Placement(transformation(extent={{90,40},{150,100}})));
  BatchTank B6(area_m2=0.05, levelStart_m=0.01, wStart=0.0, Tstart_K=350.15) annotation(Placement(transformation(extent={{180,90},{220,130}})));
  BatchTank B7(area_m2=0.05, levelStart_m=0.01, wStart=0.0, Tstart_K=360.15) annotation(Placement(transformation(extent={{180,10},{220,50}})));
  CentralController controller annotation(Placement(transformation(extent={{-10,40},{30,80}})));
  Modelica.Blocks.Sources.BooleanConstant startEnable(k=true) annotation(Placement(transformation(extent={{-180,-20},{-160,0}})));
  Modelica.Blocks.Sources.BooleanConstant B3avail(k=true) annotation(Placement(transformation(extent={{-180,-50},{-160,-30}})));
  Modelica.Blocks.Sources.Constant fis801(k=0.12) annotation(Placement(transformation(extent={{-180,-120},{-160,-100}})));
  Modelica.Blocks.Math.BooleanToReal P1r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{60,-160},{80,-140}})));
  Modelica.Blocks.Math.BooleanToReal P2r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{90,-160},{110,-140}})));
  Modelica.Blocks.Math.BooleanToReal Htr(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{120,-160},{140,-140}})));
  Modelica.Blocks.Math.BooleanToReal C6r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{150,-160},{170,-140}})));
  Modelica.Blocks.Math.BooleanToReal C7r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{180,-160},{200,-140}})));
  Modelica.Blocks.Math.BooleanToReal V1r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{-120,-200},{-100,-180}})));
  Modelica.Blocks.Math.BooleanToReal V3r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{-96,-200},{-76,-180}})));
  Modelica.Blocks.Math.BooleanToReal V5r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{-72,-200},{-52,-180}})));
  Modelica.Blocks.Math.BooleanToReal V6r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{-48,-200},{-28,-180}})));
  Modelica.Blocks.Math.BooleanToReal V8r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{-24,-200},{-4,-180}})));
  Modelica.Blocks.Math.BooleanToReal V9r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{0,-200},{20,-180}})));
  Modelica.Blocks.Math.BooleanToReal V11r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{24,-200},{44,-180}})));
  Modelica.Blocks.Math.BooleanToReal V12r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{48,-200},{68,-180}})));
  Modelica.Blocks.Math.BooleanToReal V15r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{72,-200},{92,-180}})));
  Modelica.Blocks.Math.BooleanToReal V18r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{96,-200},{116,-180}})));
  Modelica.Blocks.Math.BooleanToReal V20r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{120,-200},{140,-180}})));
  Modelica.Blocks.Math.BooleanToReal V22r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{144,-200},{164,-180}})));
  Modelica.Blocks.Math.BooleanToReal V23r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{168,-200},{188,-180}})));
  Modelica.Blocks.Math.BooleanToReal V24r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{192,-200},{212,-180}})));
  Modelica.Blocks.Math.BooleanToReal V25r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{216,-200},{236,-180}})));
  Real time_s;
  Real controller_state;
  Real region;
  Real B3_level_m;
  Real B4_level_m;
  Real B5_level_m;
  Real B6_level_m;
  Real B7_level_m;
  Real B3_w_NaCl;
  Real B5_w_NaCl;
  Real B5_temp_C;
  Real B6_temp_C;
  Real B7_temp_C;
  Real FIS801_kg_s;
  Real P1_cmd;
  Real P2_cmd;
  Real B5_heater_cmd;
  Real B6_cooler_cmd;
  Real B7_cooler_cmd;
  Real V1_open;
  Real V3_open;
  Real V5_open;
  Real V6_open;
  Real V8_open;
  Real V9_open;
  Real V11_open;
  Real V12_open;
  Real V15_open;
  Real V18_open;
  Real V20_open;
  Real V22_open;
  Real V23_open;
  Real V24_open;
  Real V25_open;
 equation
  time_s = time;
  connect(startEnable.y, controller.startEnable) annotation(Line(points={{-159,-10},{-80,-10},{-80,74},{-10,74}}, color={255,0,255}));
  connect(B3avail.y, controller.B3_available) annotation(Line(points={{-159,-40},{-90,-40},{-90,66},{-10,66}}, color={255,0,255}));
  connect(B3.level_m, controller.LIS_301) annotation(Line(points={{-49,90},{-30,90},{-30,58},{-10,58}}, color={0,0,127}));
  connect(B3.w_NaCl, controller.QI_302) annotation(Line(points={{-49,78},{-34,78},{-34,42},{-10,42}}, color={0,0,127}));
  connect(B5K1.level_m, controller.LIS_501) annotation(Line(points={{151,88},{160,88},{160,20},{-20,20},{-20,26},{-10,26}}, color={0,0,127}));
  connect(B5K1.w_NaCl, controller.QIS_502) annotation(Line(points={{151,52},{170,52},{170,0},{-10,0}}, color={0,0,127}));
  connect(B6.temp_C, controller.TIS_602) annotation(Line(points={{221,110},{230,110},{230,-20},{-10,-20}}, color={0,0,127}));
  connect(B7.temp_C, controller.TIS_702) annotation(Line(points={{221,30},{236,30},{236,-40},{-10,-40}}, color={0,0,127}));
  connect(B6.level_m, controller.LIS_601) annotation(Line(points={{221,122},{244,122},{244,-60},{-10,-60}}, color={0,0,127}));
  connect(B7.level_m, controller.LIS_701) annotation(Line(points={{221,42},{248,42},{248,-80},{-10,-80}}, color={0,0,127}));
  B1.qIn_kg_s = if controller.P2 then 0.30 else 0;
  B1.wIn_kg_kg = 0;
  B1.qOutCmd_kg_s = if controller.V8 then 0.30 else 0;
  B1.heatFlow_W = 0;
  B2.qIn_kg_s = if controller.P1 then 0.30 else 0;
  B2.wIn_kg_kg = B7.w_NaCl;
  B2.qOutCmd_kg_s = if controller.V9 then 0.30 else 0;
  B2.heatFlow_W = 0;
  B3.qIn_kg_s = B1.qOut_kg_s + B2.qOut_kg_s;
  B3.wIn_kg_kg = if B3.qIn_kg_s > 0 then (B1.qOut_kg_s*B1.w_NaCl + B2.qOut_kg_s*B2.w_NaCl)/B3.qIn_kg_s else 0;
  B3.qOutCmd_kg_s = if controller.V11 then 0.30 else 0;
  B3.heatFlow_W = 0;
  B4.qIn_kg_s = B3.qOut_kg_s;
  B4.wIn_kg_kg = B3.w_NaCl;
  B4.qOutCmd_kg_s = if controller.V12 then 0.30 else 0;
  B4.heatFlow_W = 0;
  connect(B4.qOut_kg_s, B5K1.feed_kg_s) annotation(Line(points={{41,70},{70,70},{70,70},{89,70}}, color={0,127,255}));
  connect(B4.w_NaCl, B5K1.feed_w_kg_kg) annotation(Line(points={{41,78},{68,78},{68,30},{89,30}}, color={0,0,127}));
  B5K1.transferToB7Cmd_kg_s = if controller.V15 then 0.30 else 0;
  B5K1.heaterCmd = controller.HeaterB5;
  connect(fis801.y, B5K1.condenserFlowProof_kg_s) annotation(Line(points={{-159,-110},{60,-110},{60,-110},{0,-110}}, color={0,0,127}));
  B6.qIn_kg_s = B5K1.condensateToB6_kg_s;
  B6.wIn_kg_kg = 0;
  B6.qOutCmd_kg_s = if controller.P2 then 0.30 else 0;
  B6.heatFlow_W = if controller.CoolerB6 then -6500 else 0;
  B7.qIn_kg_s = B5K1.concentrateToB7_kg_s;
  B7.wIn_kg_kg = B5K1.w_NaCl;
  B7.qOutCmd_kg_s = if controller.P1 then 0.30 else 0;
  B7.heatFlow_W = if controller.CoolerB7 then -4500 else 0;
  connect(controller.P1, P1r.u) annotation(Line(points={{80,-108},{70,-108},{70,-161}}, color={255,0,255}));
  connect(controller.P2, P2r.u) annotation(Line(points={{40,-108},{100,-108},{100,-161}}, color={255,0,255}));
  connect(controller.HeaterB5, Htr.u) annotation(Line(points={{0,-108},{130,-108},{130,-161}}, color={255,0,255}));
  connect(controller.CoolerB6, C6r.u) annotation(Line(points={{-40,-108},{160,-108},{160,-161}}, color={255,0,255}));
  connect(controller.CoolerB7, C7r.u) annotation(Line(points={{-80,-108},{190,-108},{190,-161}}, color={255,0,255}));
  connect(controller.V1, V1r.u) annotation(Line(points={{120,60},{120,-170},{-110,-170},{-110,-201}}, color={255,0,255}));
  connect(controller.V3, V3r.u) annotation(Line(points={{120,48},{124,-172},{-86,-172},{-86,-201}}, color={255,0,255}));
  connect(controller.V5, V5r.u) annotation(Line(points={{120,36},{128,-174},{-62,-174},{-62,-201}}, color={255,0,255}));
  connect(controller.V6, V6r.u) annotation(Line(points={{120,24},{132,-176},{-38,-176},{-38,-201}}, color={255,0,255}));
  connect(controller.V8, V8r.u) annotation(Line(points={{120,12},{136,-178},{-14,-178},{-14,-201}}, color={255,0,255}));
  connect(controller.V9, V9r.u) annotation(Line(points={{120,0},{140,-180},{10,-180},{10,-201}}, color={255,0,255}));
  connect(controller.V11, V11r.u) annotation(Line(points={{120,-12},{144,-182},{34,-182},{34,-201}}, color={255,0,255}));
  connect(controller.V12, V12r.u) annotation(Line(points={{120,-24},{148,-184},{58,-184},{58,-201}}, color={255,0,255}));
  connect(controller.V15, V15r.u) annotation(Line(points={{120,-36},{152,-186},{82,-186},{82,-201}}, color={255,0,255}));
  connect(controller.V18, V18r.u) annotation(Line(points={{120,-48},{156,-188},{106,-188},{106,-201}}, color={255,0,255}));
  connect(controller.V20, V20r.u) annotation(Line(points={{120,-60},{160,-190},{130,-190},{130,-201}}, color={255,0,255}));
  connect(controller.V22, V22r.u) annotation(Line(points={{120,-72},{164,-192},{154,-192},{154,-201}}, color={255,0,255}));
  connect(controller.V23, V23r.u) annotation(Line(points={{120,-84},{168,-194},{178,-194},{178,-201}}, color={255,0,255}));
  connect(controller.V24, V24r.u) annotation(Line(points={{120,-96},{172,-196},{202,-196},{202,-201}}, color={255,0,255}));
  connect(controller.V25, V25r.u) annotation(Line(points={{120,-108},{176,-198},{226,-198},{226,-201}}, color={255,0,255}));
  controller_state = controller.controller_state;
  region = controller.region;
  B3_level_m = B3.level_m;
  B4_level_m = B4.level_m;
  B5_level_m = B5K1.level_m;
  B6_level_m = B6.level_m;
  B7_level_m = B7.level_m;
  B3_w_NaCl = B3.w_NaCl;
  B5_w_NaCl = B5K1.w_NaCl;
  B5_temp_C = B5K1.temp_C;
  B6_temp_C = B6.temp_C;
  B7_temp_C = B7.temp_C;
  FIS801_kg_s = fis801.k;
  P1_cmd = P1r.y;
  P2_cmd = P2r.y;
  B5_heater_cmd = Htr.y;
  B6_cooler_cmd = C6r.y;
  B7_cooler_cmd = C7r.y;
  V1_open = V1r.y;
  V3_open = V3r.y;
  V5_open = V5r.y;
  V6_open = V6r.y;
  V8_open = V8r.y;
  V9_open = V9r.y;
  V11_open = V11r.y;
  V12_open = V12r.y;
  V15_open = V15r.y;
  V18_open = V18r.y;
  V20_open = V20r.y;
  V22_open = V22r.y;
  V23_open = V23r.y;
  V24_open = V24r.y;
  V25_open = V25r.y;
  annotation(experiment(StartTime=0, StopTime=3000, Tolerance=1e-6, Interval=1));
end NaClBatchPlantSystem;
