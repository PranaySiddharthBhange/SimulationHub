within ;
model NaClBatchSystem
  extends Modelica.Icons.Example;
  parameter Modelica.Units.SI.Pressure ambientPressure = 101325;
  parameter Modelica.Units.SI.Temperature ambientTemperature = 293.15;
  parameter Real FIS801_proof(unit="kg/s") = 0.12;
  Modelica.Blocks.Sources.BooleanConstant startEnable(k=true) annotation(Placement(transformation(extent={{-180,140},{-160,160}})));
  Modelica.Blocks.Sources.BooleanConstant B3_available(k=true) annotation(Placement(transformation(extent={{-180,110},{-160,130}})));
  Modelica.Blocks.Sources.Constant FIS801(k=FIS801_proof) annotation(Placement(transformation(extent={{-180,80},{-160,100}})));
  CentralController controller annotation(Placement(transformation(extent={{-20,100},{40,160}})));
  SimpleVessel B1(crossArea=0.07, height=0.6, maxLevel=0.5, initialLevel=0.5, initialWNaCl=0, initialTemperature=ambientTemperature) annotation(Placement(transformation(extent={{-180,20},{-140,60}})));
  SimpleVessel B2(crossArea=0.07, height=0.6, maxLevel=0.5, initialLevel=0.35, initialWNaCl=0.25, initialTemperature=ambientTemperature) annotation(Placement(transformation(extent={{-180,-40},{-140,0}})));
  SimpleVessel B3(crossArea=0.05, height=0.45, maxLevel=0.38, initialLevel=0.01, initialWNaCl=0, initialTemperature=ambientTemperature) annotation(Placement(transformation(extent={{-100,-10},{-60,30}})));
  SimpleVessel B4(crossArea=0.055, height=0.45, maxLevel=0.4, initialLevel=0.01, initialWNaCl=0, initialTemperature=ambientTemperature) annotation(Placement(transformation(extent={{-20,-10},{20,30}})));
  SimpleVessel B5(crossArea=0.06, height=0.45, maxLevel=0.4, initialLevel=0.01, initialWNaCl=0, initialTemperature=ambientTemperature) annotation(Placement(transformation(extent={{60,-10},{100,30}})));
  SimpleVessel B6(crossArea=0.05, height=0.4, maxLevel=0.35, initialLevel=0.01, initialWNaCl=0, initialTemperature=353.15) annotation(Placement(transformation(extent={{140,40},{180,80}})));
  SimpleVessel B7(crossArea=0.05, height=0.4, maxLevel=0.35, initialLevel=0.01, initialWNaCl=0.18, initialTemperature=353.15) annotation(Placement(transformation(extent={{140,-80},{180,-40}})));
  Modelica.Blocks.Math.BooleanToReal P1r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,140},{100,160}})));
  Modelica.Blocks.Math.BooleanToReal P2r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,110},{100,130}})));
  Modelica.Blocks.Math.BooleanToReal Htr(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,80},{100,100}})));
  Modelica.Blocks.Math.BooleanToReal C6r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,50},{100,70}})));
  Modelica.Blocks.Math.BooleanToReal C7r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,20},{100,40}})));
  Modelica.Blocks.Math.BooleanToReal V1r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,150},{240,170}})));
  Modelica.Blocks.Math.BooleanToReal V3r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,136},{240,156}})));
  Modelica.Blocks.Math.BooleanToReal V5r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,122},{240,142}})));
  Modelica.Blocks.Math.BooleanToReal V6r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,108},{240,128}})));
  Modelica.Blocks.Math.BooleanToReal V8r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,94},{240,114}})));
  Modelica.Blocks.Math.BooleanToReal V9r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,80},{240,100}})));
  Modelica.Blocks.Math.BooleanToReal V11r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,66},{240,86}})));
  Modelica.Blocks.Math.BooleanToReal V12r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,52},{240,72}})));
  Modelica.Blocks.Math.BooleanToReal V15r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,38},{240,58}})));
  Modelica.Blocks.Math.BooleanToReal V18r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,24},{240,44}})));
  Modelica.Blocks.Math.BooleanToReal V20r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,10},{240,30}})));
  Modelica.Blocks.Math.BooleanToReal V22r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,-4},{240,16}})));
  Modelica.Blocks.Math.BooleanToReal V23r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,-18},{240,2}})));
  Modelica.Blocks.Math.BooleanToReal V24r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,-32},{240,-12}})));
  Modelica.Blocks.Math.BooleanToReal V25r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{220,-46},{240,-26}})));
  output Real time_s;
  output Integer controller_state;
  output Integer region;
  output Real B3_level_m;
  output Real B4_level_m;
  output Real B5_level_m;
  output Real B6_level_m;
  output Real B7_level_m;
  output Real B3_w_NaCl;
  output Real B5_w_NaCl;
  output Real B5_temp_C;
  output Real B6_temp_C;
  output Real B7_temp_C;
  output Real FIS801_kg_s;
  output Real P1_cmd;
  output Real P2_cmd;
  output Real B5_heater_cmd;
  output Real B6_cooler_cmd;
  output Real B7_cooler_cmd;
  output Real V1_open;
  output Real V3_open;
  output Real V5_open;
  output Real V6_open;
  output Real V8_open;
  output Real V9_open;
  output Real V11_open;
  output Real V12_open;
  output Real V15_open;
  output Real V18_open;
  output Real V20_open;
  output Real V22_open;
  output Real V23_open;
  output Real V24_open;
  output Real V25_open;
  Real q_B1_B3;
  Real q_B2_B3;
  Real q_B3_B4;
  Real q_B4_B5;
  Real q_B5_B7;
  Real q_B6_B1;
  Real q_B7_B2;
  Real q_cond;
  Real qevap;
  Real heaterQ;
  Real cooler6Q;
  Real cooler7Q;
equation
  connect(startEnable.y, controller.startEnable) annotation(Line(points={{-159,150},{-40,150},{-40,150},{-20,150}}, color={255,0,255}));
  connect(B3_available.y, controller.B3_available) annotation(Line(points={{-159,120},{-40,120},{-40,144},{-20,144}}, color={255,0,255}));
  controller.LIS_301 = B3.level;
  controller.QI_302 = B3.wNaCl;
  controller.LIS_501 = B5.level;
  controller.QIS_502 = B5.wNaCl;
  controller.TIS_602 = B6.temperature - 273.15;
  controller.TIS_702 = B7.temperature - 273.15;
  connect(FIS801.y, controller.FIS_801) annotation(Line(points={{-159,90},{-60,90},{-60,106},{-20,106}}, color={0,0,127}));
  controller.LIS_601 = B6.level;
  controller.LIS_701 = B7.level;
  q_B1_B3 = if controller.V8 then 0.0003 else 0;
  q_B2_B3 = if controller.V9 then 0.00015 else 0;
  q_B3_B4 = if controller.V11 then 0.0003 else 0;
  q_B4_B5 = if controller.V12 then 0.0003 else 0;
  q_B5_B7 = if controller.V15 then 0.0001 else 0;
  q_B6_B1 = if controller.P2 and B6.level > 0.02 then 0.0003 else 0;
  q_B7_B2 = if controller.P1 and B7.level > 0.02 then 0.0003 else 0;
  qevap = if controller.heaterB5 and B5.level > 0.05 and FIS801_proof >= 0.10 then 1.0e-5 else 0;
  q_cond = qevap;
  heaterQ = if controller.heaterB5 then 20000 else 0;
  cooler6Q = if controller.coolerB6 then -6500 else 0;
  cooler7Q = if controller.coolerB7 then -4500 else 0;
  B1.qIn = q_B6_B1;
  B1.qOutCmd = q_B1_B3;
  B1.wIn = 0;
  B1.TIn = ambientTemperature;
  B1.Qext = 0;
  B2.qIn = q_B7_B2;
  B2.qOutCmd = q_B2_B3;
  B2.wIn = B7.wNaCl;
  B2.TIn = B7.temperature;
  B2.Qext = 0;
  B3.qIn = q_B1_B3 + q_B2_B3;
  B3.qOutCmd = q_B3_B4;
  B3.wIn = if q_B1_B3 + q_B2_B3 > 1e-12 then (q_B1_B3*B1.wNaCl + q_B2_B3*B2.wNaCl)/(q_B1_B3 + q_B2_B3) else 0;
  B3.TIn = if q_B1_B3 + q_B2_B3 > 1e-12 then (q_B1_B3*B1.temperature + q_B2_B3*B2.temperature)/(q_B1_B3 + q_B2_B3) else ambientTemperature;
  B3.Qext = 0;
  B4.qIn = q_B3_B4;
  B4.qOutCmd = q_B4_B5;
  B4.wIn = B3.wNaCl;
  B4.TIn = B3.temperature;
  B4.Qext = 0;
  B5.qIn = q_B4_B5;
  B5.qOutCmd = q_B5_B7 + q_cond + qevap;
  B5.wIn = B4.wNaCl;
  B5.TIn = B4.temperature;
  B5.Qext = heaterQ;
  B6.qIn = q_cond;
  B6.qOutCmd = q_B6_B1;
  B6.wIn = 0;
  B6.TIn = B5.temperature;
  B6.Qext = cooler6Q;
  B7.qIn = q_B5_B7;
  B7.qOutCmd = q_B7_B2;
  B7.wIn = B5.wNaCl;
  B7.TIn = B5.temperature;
  B7.Qext = cooler7Q;
  connect(controller.P1, P1r.u) annotation(Line(points={{40.4,-80},{60,-80},{60,150},{78,150}}, color={255,0,255}));
  connect(controller.P2, P2r.u) annotation(Line(points={{40.4,-92},{56,-92},{56,120},{78,120}}, color={255,0,255}));
  connect(controller.heaterB5, Htr.u) annotation(Line(points={{80,-92},{90,-92},{90,90},{78,90}}, color={255,0,255}));
  connect(controller.coolerB6, C6r.u) annotation(Line(points={{40,-92},{46,-92},{46,60},{78,60}}, color={255,0,255}));
  connect(controller.coolerB7, C7r.u) annotation(Line(points={{0,-92},{10,-92},{10,30},{78,30}}, color={255,0,255}));
  connect(controller.V1, V1r.u) annotation(Line(points={{111,100},{150,100},{150,160},{218,160}}, color={255,0,255}));
  connect(controller.V3, V3r.u) annotation(Line(points={{111,88},{148,88},{148,146},{218,146}}, color={255,0,255}));
  connect(controller.V5, V5r.u) annotation(Line(points={{111,76},{146,76},{146,132},{218,132}}, color={255,0,255}));
  connect(controller.V6, V6r.u) annotation(Line(points={{111,64},{144,64},{144,118},{218,118}}, color={255,0,255}));
  connect(controller.V8, V8r.u) annotation(Line(points={{111,52},{142,52},{142,104},{218,104}}, color={255,0,255}));
  connect(controller.V9, V9r.u) annotation(Line(points={{111,40},{140,40},{140,90},{218,90}}, color={255,0,255}));
  connect(controller.V11, V11r.u) annotation(Line(points={{111,28},{138,28},{138,76},{218,76}}, color={255,0,255}));
  connect(controller.V12, V12r.u) annotation(Line(points={{111,16},{136,16},{136,62},{218,62}}, color={255,0,255}));
  connect(controller.V15, V15r.u) annotation(Line(points={{111,4},{134,4},{134,48},{218,48}}, color={255,0,255}));
  connect(controller.V18, V18r.u) annotation(Line(points={{111,-8},{132,-8},{132,34},{218,34}}, color={255,0,255}));
  connect(controller.V20, V20r.u) annotation(Line(points={{111,-20},{130,-20},{130,20},{218,20}}, color={255,0,255}));
  connect(controller.V22, V22r.u) annotation(Line(points={{111,-32},{128,-32},{128,6},{218,6}}, color={255,0,255}));
  connect(controller.V23, V23r.u) annotation(Line(points={{111,-44},{126,-44},{126,-8},{218,-8}}, color={255,0,255}));
  connect(controller.V24, V24r.u) annotation(Line(points={{111,-56},{124,-56},{124,-22},{218,-22}}, color={255,0,255}));
  connect(controller.V25, V25r.u) annotation(Line(points={{111,-68},{122,-68},{122,-36},{218,-36}}, color={255,0,255}));
  time_s = time;
  controller_state = controller.controller_state;
  region = controller.region;
  B3_level_m = B3.level;
  B4_level_m = B4.level;
  B5_level_m = B5.level;
  B6_level_m = B6.level;
  B7_level_m = B7.level;
  B3_w_NaCl = B3.wNaCl;
  B5_w_NaCl = B5.wNaCl;
  B5_temp_C = B5.temperature - 273.15;
  B6_temp_C = B6.temperature - 273.15;
  B7_temp_C = B7.temperature - 273.15;
  FIS801_kg_s = FIS801_proof;
  P1_cmd = P1r.y;
  P2_cmd = P2r.y;
  B5_heater_cmd = Htr.y;
  B6_cooler_cmd = C6r.y;
  B7_cooler_cmd = C7r.y;
  V1_open = V1r.y;
  V3_open = V3r.y;
  V5_open = V5r.y;
  V6_open = V6r.y;
  V8_open = V8r.y;
  V9_open = V9r.y;
  V11_open = V11r.y;
  V12_open = V12r.y;
  V15_open = V15r.y;
  V18_open = V18r.y;
  V20_open = V20r.y;
  V22_open = V22r.y;
  V23_open = V23r.y;
  V24_open = V24r.y;
  V25_open = V25r.y;
  annotation(experiment(StartTime=0, StopTime=3000, Tolerance=1e-6, Interval=1), Diagram(graphics={Text(extent={{-190,170},{-110,180}}, textString="B1->V8->B3"),Text(extent={{-190,100},{-110,110}}, textString="B2->V9->B3"),Text(extent={{-40,40},{40,50}}, textString="B3->V11->B4->V12->B5"),Text(extent={{120,90},{200,100}}, textString="B5 vapor->K1->B6"),Text(extent={{120,-30},{200,-20}}, textString="B5 conc->V15->B7")}));
end NaClBatchSystem;
