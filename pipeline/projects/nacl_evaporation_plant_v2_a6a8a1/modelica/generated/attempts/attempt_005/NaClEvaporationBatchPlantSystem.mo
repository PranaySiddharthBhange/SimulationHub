model NaClEvaporationBatchPlantSystem
  extends Modelica.Icons.Example;
  parameter Modelica.Units.SI.Time stopTime=3000;
  parameter Integer intervals=600;
  parameter Modelica.Units.SI.VolumeFlowRate qChargeB1=0.001;
  parameter Modelica.Units.SI.VolumeFlowRate qChargeB2=0.0004;
  parameter Modelica.Units.SI.VolumeFlowRate qB3toB4=0.0008;
  parameter Modelica.Units.SI.VolumeFlowRate qB4toB5=0.0012;
  parameter Modelica.Units.SI.MassFlowRate mEvap=0.02;
  parameter Modelica.Units.SI.VolumeFlowRate qB5toB7=0.0005;
  parameter Modelica.Units.SI.VolumeFlowRate qReturnB6=0.0003;
  parameter Modelica.Units.SI.VolumeFlowRate qReturnB7=0.0003;
  parameter Modelica.Units.SI.Temperature ambientT=293.15;
  parameter Modelica.Units.SI.Temperature condensateT=353.15;
  parameter Real FIS801_nominal(unit="kg/s")=0.12;
  SimpleBatchTank B1(area=0.07, levelMax=0.5, levelStart=0.45, XStart=0.0, TStart=ambientT) annotation(Placement(transformation(extent={{-140,40},{-100,80}})));
  SimpleBatchTank B2(area=0.07, levelMax=0.5, levelStart=0.20, XStart=0.25, TStart=ambientT) annotation(Placement(transformation(extent={{-140,-20},{-100,20}})));
  SimpleBatchTank B3(area=0.05, levelMax=0.38, levelStart=1e-4, XStart=0.0, TStart=ambientT) annotation(Placement(transformation(extent={{-60,10},{-20,50}})));
  SimpleBatchTank B4(area=0.055, levelMax=0.4, levelStart=1e-4, XStart=0.0, TStart=ambientT) annotation(Placement(transformation(extent={{20,10},{60,50}})));
  SimpleBatchTank B5(area=0.06, levelMax=0.4, levelStart=1e-4, XStart=0.0, TStart=ambientT) annotation(Placement(transformation(extent={{100,10},{140,50}})));
  SimpleBatchTank K1(area=0.01, levelMax=0.2, levelStart=1e-4, XStart=0.0, TStart=condensateT) annotation(Placement(transformation(extent={{100,80},{140,120}})));
  SimpleBatchTank B6(area=0.05, levelMax=0.35, levelStart=1e-4, XStart=0.0, TStart=condensateT) annotation(Placement(transformation(extent={{180,80},{220,120}})));
  SimpleBatchTank B7(area=0.05, levelMax=0.35, levelStart=1e-4, XStart=0.0, TStart=353.15) annotation(Placement(transformation(extent={{180,-20},{220,20}})));
  NaClBatchController controller annotation(Placement(transformation(extent={{-10,100},{70,180}})));
  Modelica.Blocks.Sources.BooleanTable startCmd(table={0,0.2,2505,2505.2}, startValue=false) annotation(Placement(transformation(extent={{-140,150},{-120,170}})));
  Modelica.Blocks.Sources.Constant fisFlow(k=FIS801_nominal) annotation(Placement(transformation(extent={{-60,200},{-40,220}})));
  Modelica.Blocks.Math.BooleanToReal p1Real(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,-90},{100,-70}})));
  Modelica.Blocks.Math.BooleanToReal p2Real(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{80,-120},{100,-100}})));
  Modelica.Blocks.Math.BooleanToReal hReal(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{110,-120},{130,-100}})));
  Modelica.Blocks.Math.BooleanToReal c6Real(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{140,-120},{160,-100}})));
  Modelica.Blocks.Math.BooleanToReal c7Real(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{170,-120},{190,-100}})));
  Modelica.Blocks.Math.BooleanToReal v1r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,140},{270,160}})));
  Modelica.Blocks.Math.BooleanToReal v3r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,126},{270,146}})));
  Modelica.Blocks.Math.BooleanToReal v5r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,112},{270,132}})));
  Modelica.Blocks.Math.BooleanToReal v6r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,98},{270,118}})));
  Modelica.Blocks.Math.BooleanToReal v8r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,84},{270,104}})));
  Modelica.Blocks.Math.BooleanToReal v9r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,70},{270,90}})));
  Modelica.Blocks.Math.BooleanToReal v11r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,56},{270,76}})));
  Modelica.Blocks.Math.BooleanToReal v12r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,42},{270,62}})));
  Modelica.Blocks.Math.BooleanToReal v15r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,28},{270,48}})));
  Modelica.Blocks.Math.BooleanToReal v18r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,14},{270,34}})));
  Modelica.Blocks.Math.BooleanToReal v20r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,0},{270,20}})));
  Modelica.Blocks.Math.BooleanToReal v22r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,-14},{270,6}})));
  Modelica.Blocks.Math.BooleanToReal v23r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,-28},{270,-8}})));
  Modelica.Blocks.Math.BooleanToReal v24r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,-42},{270,-22}})));
  Modelica.Blocks.Math.BooleanToReal v25r(realTrue=1, realFalse=0) annotation(Placement(transformation(extent={{250,-56},{270,-36}})));
  Real time_s;
  Integer controller_state;
  Integer region;
  Real B3_level;
  Real B4_level;
  Real B5_level;
  Real B6_level;
  Real B7_level;
  Real B3_X_NaCl;
  Real B5_X_NaCl;
  Real B5_T;
  Real B6_T;
  Real B7_T;
  Real FIS801_flow;
  Real P1_cmd;
  Real P2_cmd;
  Real B5_heater_cmd;
  Real B6_cooler_cmd;
  Real B7_cooler_cmd;
  Real V1_open;
  Real V3_open;
  Real V5_open;
  Real V6_open;
  Real V8_open;
  Real V9_open;
  Real V11_open;
  Real V12_open;
  Real V15_open;
  Real V18_open;
  Real V20_open;
  Real V22_open;
  Real V23_open;
  Real V24_open;
  Real V25_open;
equation
  connect(startCmd.y, controller.startEnable) annotation(Line(points={{-119,160},{-20,160},{-20,154},{-10,154}}, color={255,0,255}));
  connect(B3.level, controller.LIS301) annotation(Line(points={{-18,40},{-14,40},{-14,151},{-10,151}}, color={0,0,127}));
  connect(B3.X, controller.QI302) annotation(Line(points={{-18,20},{-8,20},{-8,148},{-10,148}}, color={0,0,127}));
  connect(B5.level, controller.LIS501) annotation(Line(points={{142,40},{150,40},{150,142},{-10,142}}, color={0,0,127}));
  connect(B5.X, controller.QIS502) annotation(Line(points={{142,20},{154,20},{154,139},{-10,139}}, color={0,0,127}));
  connect(B6.TdegC, controller.TIS602) annotation(Line(points={{222,90},{228,90},{228,136},{-10,136}}, color={0,0,127}));
  connect(B7.TdegC, controller.TIS702) annotation(Line(points={{222,-10},{232,-10},{232,133},{-10,133}}, color={0,0,127}));
  connect(fisFlow.y, controller.FIS801) annotation(Line(points={{-39,210},{-30,210},{-30,130},{-10,130}}, color={0,0,127}));
  connect(B6.level, controller.LIS601) annotation(Line(points={{222,110},{236,110},{236,127},{-10,127}}, color={0,0,127}));
  connect(B7.level, controller.LIS701) annotation(Line(points={{222,10},{240,10},{240,124},{-10,124}}, color={0,0,127}));

  B1.qIn = if controller.P2_on then qReturnB6 else 0;
  B1.qOutCmd = if controller.V8_open then qChargeB1*1000 else 0;
  B1.Xin = 0;
  B1.Tin = condensateT;
  B1.Qcmd = 0;
  B1.evapWater = 0;

  B2.qIn = if controller.P1_on then qReturnB7 else 0;
  B2.qOutCmd = if controller.V9_open then qChargeB2*1000 else 0;
  B2.Xin = B7.X;
  B2.Tin = ambientT;
  B2.Qcmd = 0;
  B2.evapWater = 0;

  B3.qIn = (if controller.V8_open then qChargeB1 else 0) + (if controller.V9_open then qChargeB2 else 0);
  B3.qOutCmd = if controller.V11_open then qB3toB4*1000 else 0;
  B3.Xin = if controller.V8_open or controller.V9_open then (((if controller.V8_open then qChargeB1 else 0)*0) + ((if controller.V9_open then qChargeB2 else 0)*0.25))/max(((if controller.V8_open then qChargeB1 else 0) + (if controller.V9_open then qChargeB2 else 0)), 1e-9) else 0;
  B3.Tin = ambientT;
  B3.Qcmd = 0;
  B3.evapWater = 0;

  B4.qIn = if controller.V11_open then qB3toB4 else 0;
  B4.qOutCmd = if controller.V12_open then qB4toB5*1000 else 0;
  B4.Xin = B3.X;
  B4.Tin = ambientT;
  B4.Qcmd = 0;
  B4.evapWater = 0;

  B5.qIn = if controller.V12_open then qB4toB5 else 0;
  B5.qOutCmd = if controller.V15_open then qB5toB7*1000 else 0;
  B5.Xin = B4.X;
  B5.Tin = ambientT;
  B5.Qcmd = if controller.heaterOn then 20000 else 0;
  B5.evapWater = if controller.heaterOn and B5.level >= 0.05 and FIS801_nominal >= 0.10 then mEvap else 0;

  K1.qIn = if controller.heaterOn and B5.level >= 0.05 and FIS801_nominal >= 0.10 then mEvap/1000 else 0;
  K1.qOutCmd = if controller.heaterOn and B5.level >= 0.05 and FIS801_nominal >= 0.10 then mEvap else 0;
  K1.Xin = 0;
  K1.Tin = condensateT;
  K1.Qcmd = 0;
  K1.evapWater = 0;

  B6.qIn = if controller.heaterOn and B5.level >= 0.05 and FIS801_nominal >= 0.10 then mEvap/1000 else 0;
  B6.qOutCmd = if controller.P2_on then qReturnB6*1000 else 0;
  B6.Xin = 0;
  B6.Tin = condensateT;
  B6.Qcmd = if controller.coolerB6On then -6500 else 0;
  B6.evapWater = 0;

  B7.qIn = if controller.V15_open then qB5toB7 else 0;
  B7.qOutCmd = if controller.P1_on then qReturnB7*1000 else 0;
  B7.Xin = B5.X;
  B7.Tin = B5.TdegC + 273.15;
  B7.Qcmd = if controller.coolerB7On then -4500 else 0;
  B7.evapWater = 0;

  connect(controller.P1_on, p1Real.u) annotation(Line(points={{71,-80},{80,-80}}, color={255,0,255}));
  connect(controller.P2_on, p2Real.u) annotation(Line(points={{71,-92},{76,-92},{76,-110},{80,-110}}, color={255,0,255}));
  connect(controller.heaterOn, hReal.u) annotation(Line(points={{50,-110},{110,-110}}, color={255,0,255}));
  connect(controller.coolerB6On, c6Real.u) annotation(Line(points={{10,-110},{140,-110}}, color={255,0,255}));
  connect(controller.coolerB7On, c7Real.u) annotation(Line(points={{-30,-110},{170,-110}}, color={255,0,255}));
  connect(controller.V1_open, v1r.u) annotation(Line(points={{71,100},{250,150}}, color={255,0,255}));
  connect(controller.V3_open, v3r.u) annotation(Line(points={{71,88},{250,136}}, color={255,0,255}));
  connect(controller.V5_open, v5r.u) annotation(Line(points={{71,76},{250,122}}, color={255,0,255}));
  connect(controller.V6_open, v6r.u) annotation(Line(points={{71,64},{250,108}}, color={255,0,255}));
  connect(controller.V8_open, v8r.u) annotation(Line(points={{71,52},{250,94}}, color={255,0,255}));
  connect(controller.V9_open, v9r.u) annotation(Line(points={{71,40},{250,80}}, color={255,0,255}));
  connect(controller.V11_open, v11r.u) annotation(Line(points={{71,28},{250,66}}, color={255,0,255}));
  connect(controller.V12_open, v12r.u) annotation(Line(points={{71,16},{250,52}}, color={255,0,255}));
  connect(controller.V15_open, v15r.u) annotation(Line(points={{71,4},{250,38}}, color={255,0,255}));
  connect(controller.V18_open, v18r.u) annotation(Line(points={{71,-8},{250,24}}, color={255,0,255}));
  connect(controller.V20_open, v20r.u) annotation(Line(points={{71,-20},{250,10}}, color={255,0,255}));
  connect(controller.V22_open, v22r.u) annotation(Line(points={{71,-32},{250,-4}}, color={255,0,255}));
  connect(controller.V23_open, v23r.u) annotation(Line(points={{71,-44},{250,-18}}, color={255,0,255}));
  connect(controller.V24_open, v24r.u) annotation(Line(points={{71,-56},{250,-32}}, color={255,0,255}));
  connect(controller.V25_open, v25r.u) annotation(Line(points={{71,-68},{250,-46}}, color={255,0,255}));

  time_s = time;
  controller_state = controller.controller_state;
  region = controller.region;
  B3_level = B3.level;
  B4_level = B4.level;
  B5_level = B5.level;
  B6_level = B6.level;
  B7_level = B7.level;
  B3_X_NaCl = B3.X;
  B5_X_NaCl = B5.X;
  B5_T = B5.TdegC;
  B6_T = B6.TdegC;
  B7_T = B7.TdegC;
  FIS801_flow = fisFlow.y;
  P1_cmd = p1Real.y;
  P2_cmd = p2Real.y;
  B5_heater_cmd = hReal.y;
  B6_cooler_cmd = c6Real.y;
  B7_cooler_cmd = c7Real.y;
  V1_open = v1r.y;
  V3_open = v3r.y;
  V5_open = v5r.y;
  V6_open = v6r.y;
  V8_open = v8r.y;
  V9_open = v9r.y;
  V11_open = v11r.y;
  V12_open = v12r.y;
  V15_open = v15r.y;
  V18_open = v18r.y;
  V20_open = v20r.y;
  V22_open = v22r.y;
  V23_open = v23r.y;
  V24_open = v24r.y;
  V25_open = v25r.y;
  annotation(experiment(StartTime=0, StopTime=3000, Tolerance=1e-6, Interval=5));
end NaClEvaporationBatchPlantSystem;
